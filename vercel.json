{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/gateway.ts": { "maxDuration": 120 }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/gateway?route=:path*" },
    { "source": "/:page(assistant|team|spending-policy|activity|saved-notes|connections)", "destination": "/index.html" },
    { "source": "/projects/:path*", "destination": "/index.html" },
    { "source": "/requests/:path*", "destination": "/index.html" }
  ]
}
