# LOCAL: copy this file to .env.local (the server loads .env.local, not .env).
# Set GEMINI_API_KEY for Koa. Leave hosted settings empty for localhost.
GEMINI_API_KEY=
# Optional; use a JSON-capable model available to your Google project.
GEMINI_MODEL=

# RENDER BACKEND: set these in Render Environment, not in browser code.
# Generate separate random tokens of at least 24 characters.
ALLOWANCE_OWNER_SETUP_TOKEN=
ALLOWANCE_PROXY_TOKEN=
# Exact Vercel HTTPS origin, no trailing slash. Same value in both hosts.
ALLOWANCE_PUBLIC_ORIGIN=
# Generate 32 random bytes encoded as base64; keep stable across redeploys.
# Also needed for local Testnet protected storage on Linux/macOS.
ALLOWANCE_STORAGE_KEY=
# Copy Session pooler URI from Supabase; URL-encode the password.
SUPABASE_DATABASE_URL=
# Whole Supabase CA PEM, including BEGIN/END; literal \n is supported.
SUPABASE_CA_CERT=
# Dockerfile supplies this on Render. Leave empty locally to use .local/.
ALLOWANCE_DATA_DIR=
# Render provides PORT automatically; leave empty locally.
PORT=

# VERCEL SERVER-SIDE GATEWAY ONLY (Production environment).
# Render HTTPS origin, no trailing slash.
ALLOWANCE_BACKEND_URL=
# Also set ALLOWANCE_PUBLIC_ORIGIN and ALLOWANCE_PROXY_TOKEN above.
# Never prefix secrets with VITE_ or NEXT_PUBLIC_.
# Wallet agent/merchant keys and Velo Gas keys are generated/saved through
# Connections and encrypted on the backend; do not paste them here or commit them.
